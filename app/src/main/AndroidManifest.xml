<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.projectsync">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProjectSync">
        <activity
            android:name=".ui.pmo.PerformancePredictionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.student.StudentDashboardActivity" />
        <activity android:name=".ui.supervisor.SupervisorDashboardActivity" />
        <activity android:name=".ui.pmo.PMODashboardActivity" />
        <activity android:name=".ui.admin.AdminDashboardActivity" />
        <activity android:name=".ui.admin.UserManagementActivity" />
        <activity android:name=".ui.AnnouncementsActivity" />
        <activity android:name=".ui.ProfileActivity" />

    </application>

</manifest>