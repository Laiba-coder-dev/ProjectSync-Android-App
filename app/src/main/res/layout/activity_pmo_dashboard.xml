<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:text="Welcome PMO"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Monitor and manage all projects"
            android:textColor="#666"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Total Projects -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            android:backgroundTint="#E3F2FD"
            android:id="@+id/card_total_projects">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:orientation="vertical">

                <TextView
                    android:text="Total Projects"
                    android:textColor="#555"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="20 Projects"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pending Approvals -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            android:backgroundTint="#E8EAF6"
            android:id="@+id/card_pending_approvals">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:orientation="vertical">

                <TextView
                    android:text="Pending Approvals"
                    android:textColor="#555"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="4 Pending"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:text="Quick Actions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- View All Projects -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_all_projects"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="View All Projects"
            android:textColor="@android:color/white"
            android:backgroundTint="#1976D2"
            app:cornerRadius="28dp"/>

        <!-- Monitor Progress -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_monitor_progress"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Monitor Progress"
            android:textColor="@android:color/white"
            android:backgroundTint="#1A237E"
            app:cornerRadius="28dp"/>

        <!-- 🔥 ADD ANNOUNCEMENT BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_announcement"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Add Announcement"
            android:textColor="@android:color/white"
            android:backgroundTint="#0D47A1"
            app:cornerRadius="28dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_predict_performance"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Student Performance Prediction"
            android:textColor="@android:color/white"
            android:backgroundTint="#283593"
            app:cornerRadius="28dp"/>
    </LinearLayout>

</ScrollView>