<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:text="Welcome Admin"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

        <TextView
            android:text="System overview and management"
            android:textColor="#666"
            android:layout_marginBottom="20dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

        <!-- Users -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            android:backgroundTint="#E3F2FD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:orientation="vertical">

                <TextView
                    android:text="Total Users"
                    android:textColor="#555"   android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:text="120 Users"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1"
                    android:layout_marginTop="8dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Projects -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            android:backgroundTint="#E8EAF6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:orientation="vertical">

                <TextView
                    android:text="Total Projects"
                    android:textColor="#555"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:text="30 Projects"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"
                    android:layout_marginTop="8dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:text="Quick Actions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manage_users"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Manage Users"
            android:textColor="@android:color/white"
            android:backgroundTint="#1976D2"
            app:cornerRadius="28dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_stats"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="View Statistics"
            android:textColor="@android:color/white"
            android:backgroundTint="#1A237E"
            app:cornerRadius="28dp"/>

    </LinearLayout>

</ScrollView>